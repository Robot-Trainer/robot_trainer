{
  "compilerOptions": {
    "target": "ES2025",
    "module": "ESNext",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "types": ["w3c-web-serial"],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
