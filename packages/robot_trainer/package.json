{
  "name": "robot_trainer",
  "productName": "robot_trainer",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "start": "pnpm --filter @robot-trainer/lerobot build && pnpm run db:generate && pnpm exec electron-forge start -- -enable-logging --logging-level=0",
    "start:profile": "pnpm --filter @robot-trainer/lerobot build && pnpm run db:generate && pnpm exec electron-forge start -- -enable-logging --logging-level=0 --profile-startup",
    "package": "electron-forge package",
    "download-ffmpeg": "node scripts/download_ffmpeg.js",
    "test": "pnpm --filter @robot-trainer/lerobot build && pnpm exec vitest run --coverage",
    "test:playwright": "pnpm --filter @robot-trainer/lerobot build && pnpm exec playwright test",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "release": "npm run db:generate && electron-forge publish",
    "lint": "eslint .",
    "build:web": "npm run db:generate && vite build --config vite.web.config.mts",
    "dev:web": "vite --config vite.web.config.mts",
    "test:playwright:web": "PLAYWRIGHT_TEST_MODE=web playwright test --config playwright.web.config.ts"
  },
  "keywords": [],
  "author": {
    "name": "Bernie Telles",
    "email": "btelles@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^2.1.1",
    "@playwright/test": "^1.58.2",
    "@sonar/scan": "^4.3.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "electron": "41.1.0",
    "electron-react-devtools": "^0.5.3",
    "eslint": "^10.1.0",
    "ffbinaries": "^1.1.6",
    "jsdom": "^29.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-static-copy": "^4.0.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/system": "^7.3.9",
    "@mui/x-data-grid": "^8.28.1",
    "@mui/x-date-pickers": "^8.27.2",
    "@rjsf/core": "^6.4.1",
    "@rjsf/utils": "^6.4.1",
    "@rjsf/validator-ajv8": "^6.4.1",
    "@robot-trainer/lerobot": "workspace:*",
    "@serialport/bindings-cpp": "^13.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/adm-zip": "^0.5.8",
    "@types/xmldom": "^0.1.34",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "adm-zip": "^0.5.16",
    "ajv": "^8.18.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.2.2",
    "three": "^0.183.2",
    "tsx": "^4.21.0",
    "valibot": "^1.3.1",
    "ws": "^8.20.0",
    "xmldom": "^0.6.0",
    "zustand": "^5.0.12"
  }
}
