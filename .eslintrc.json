{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
"ignorePatterns": [
  "dist/",
  "build/",
  "node_modules/",
  "public/",
  "coverage/",
  "mujoco_menagerie/",
  "src/mujoco/"
]
}
